{
  "name": "@agentos/design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AgentOS 特供 UI 库：design tokens + shadcn 组件 + Tailwind preset",
  "exports": {
    ".": "./src/index.ts",
    "./styles/tokens.css": "./src/tokens/tokens.css",
    "./tailwind-preset": "./tailwind.preset.ts",
    "./tw-merge": "./src/lib/tw-merge.ts",
    "./design": "./DESIGN.md",
    "./design/token-reference": "./docs/token-reference.md"
  },
  "types": "./src/index.ts",
  "scripts": {
    "build:tokens": "node ./scripts/build-design-tokens.mjs",
    "lint": "pnpm exec biome check .",
    "typecheck": "pnpm -w run tsc:compat -- -p packages/@agentos/design-system/tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006 -c storybook/.storybook",
    "build-storybook": "storybook build -c storybook/.storybook -o storybook/dist",
    "build": "pnpm run /^build:.*/",
    "preview-storybook": "npx --yes serve storybook/dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.0",
    "@tabler/icons-react": "^3.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/theming": "^8.6.14",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.22.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^8.6.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.3.5"
  }
}
